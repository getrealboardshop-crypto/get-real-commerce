{% comment %}
  GET REAL PRODUCTS v1.1

  CHANGELOG
  - Added Get Real badge wording
  - Added tag-based badges
  - Preserved existing layout and product-card styling
{% endcomment %}

<section
  id="GRProducts-{{ section.id }}"
  class="gr-products"
>
  <div class="gr-products__inner page-width">
    <div class="gr-products__header">
      {% if section.settings.heading != blank %}
        <h2 class="gr-products__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.settings.collection != blank and section.settings.show_view_all %}
        <a
          class="gr-products__view-all"
          href="{{ section.settings.collection.url }}"
        >
          {{ section.settings.view_all_label | escape }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>

    {% if section.settings.collection != blank %}
      <div class="gr-products__grid">
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% render 'gr-product-card',
            card_product: product,
            show_vendor: section.settings.show_vendor,
            show_second_image: section.settings.show_second_image,
            show_quick_add: section.settings.show_quick_add,
            sold_out_label: section.settings.sold_out_label,
            sale_label: section.settings.sale_label,
            new_drop_label: section.settings.new_drop_label,
            new_drop_tag: section.settings.new_drop_tag,
            back_in_label: section.settings.back_in_label,
            back_in_tag: section.settings.back_in_tag,
            staff_pick_label: section.settings.staff_pick_label,
            staff_pick_tag: section.settings.staff_pick_tag,
            limited_label: section.settings.limited_label,
            limited_tag: section.settings.limited_tag
          %}
        {% endfor %}
      </div>

      {% if section.settings.show_bottom_button %}
        <div class="gr-products__bottom">
          <a
            class="gr-products__bottom-button"
            href="{{ section.settings.collection.url }}"
          >
            {{ section.settings.view_all_label | escape }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <div class="gr-products__empty">
        Select a collection in the section settings.
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  #GRProducts-{{ section.id }} {
    --gr-products-background: {{ section.settings.background_color }};
    --gr-products-text: {{ section.settings.text_color }};
    --gr-card-background: {{ section.settings.card_background }};
    --gr-image-background: {{ section.settings.image_background }};
    --gr-card-border: {{ section.settings.border_color }};
    --gr-card-radius: {{ section.settings.card_radius }}px;
    --gr-image-radius: {{ section.settings.image_radius }}px;
    --gr-card-lift: {{ section.settings.hover_lift }}px;
    --gr-image-zoom: {{ section.settings.hover_zoom | divided_by: 100.0 }};
    --gr-grid-gap: {{ section.settings.grid_gap }}px;
    --gr-mobile-gap: {{ section.settings.mobile_grid_gap }}px;
    --gr-card-padding: {{ section.settings.card_padding }}px;
    --gr-title-size: {{ section.settings.product_title_size }}px;
    --gr-vendor-size: {{ section.settings.vendor_size }}px;
    --gr-price-size: {{ section.settings.price_size }}px;
    --gr-badge-background: {{ section.settings.badge_background }};
    --gr-badge-text: {{ section.settings.badge_text }};
    --gr-quick-background: {{ section.settings.quick_add_background }};
    --gr-quick-text: {{ section.settings.quick_add_text }};

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: var(--gr-products-background);
    color: var(--gr-products-text);
  }

  #GRProducts-{{ section.id }} .gr-products__heading {
    font-size: {{ section.settings.heading_size }}px;
  }

  #GRProducts-{{ section.id }} .gr-products__grid {
    grid-template-columns: repeat(
      {{ section.settings.columns_desktop }},
      minmax(0, 1fr)
    );
  }

  #GRProducts-{{ section.id }} .gr-product-card__media {
    aspect-ratio: {{ section.settings.image_ratio }};
  }

  #GRProducts-{{ section.id }} .gr-product-card__image,
  #GRProducts-{{ section.id }} .gr-product-card__placeholder {
    object-fit: {{ section.settings.image_fit }};
    padding: {{ section.settings.image_padding }}px;
  }

  {% if section.settings.show_card_border %}
    #GRProducts-{{ section.id }} .gr-product-card {
      border: 1px solid var(--gr-card-border);
    }
  {% endif %}

  {% if section.settings.show_card_shadow %}
    #GRProducts-{{ section.id }} .gr-product-card {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }
  {% endif %}

  @media screen and (max-width: 989px) {
    #GRProducts-{{ section.id }} .gr-products__grid {
      grid-template-columns: repeat(
        {{ section.settings.columns_tablet }},
        minmax(0, 1fr)
      );
    }
  }

  @media screen and (max-width: 749px) {
    #GRProducts-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #GRProducts-{{ section.id }} .gr-products__grid {
      grid-template-columns: repeat(
        {{ section.settings.columns_mobile }},
        minmax(0, 1fr)
      );
    }
  }
{% endstyle %}

{% stylesheet %}
  .gr-products {
    width: 100%;
  }

  .gr-products__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 30px;
  }

  .gr-products__heading {
    margin: 0;
    color: inherit;
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .gr-products__view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 3px;
    border-bottom: 1px solid currentColor;
    color: inherit;
    font-size: 13px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .gr-products__grid {
    display: grid;
    gap: var(--gr-grid-gap);
  }

  .gr-products__bottom {
    display: flex;
    justify-content: center;
    margin-top: 34px;
  }

  .gr-products__bottom-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 14px 30px;
    border: 2px solid currentColor;
    color: inherit;
    font-size: 14px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .gr-products__empty {
    padding: 48px 24px;
    border: 1px dashed currentColor;
    text-align: center;
    opacity: 0.6;
  }

  .gr-product-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    color: inherit;
    background-color: var(--gr-card-background);
    border-radius: var(--gr-card-radius);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease;
  }

  .gr-product-card:hover {
    transform: translateY(calc(var(--gr-card-lift) * -1));
  }

  .gr-product-card__visual {
    position: relative;
  }

  .gr-product-card__media-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .gr-product-card__media {
    position: relative;
    overflow: hidden;
    background-color: var(--gr-image-background);
    border-radius: var(--gr-image-radius);
  }

  .gr-product-card__image,
  .gr-product-card__placeholder {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    transition:
      opacity 260ms ease,
      transform 350ms ease;
  }

  .gr-product-card__image--secondary {
    opacity: 0;
  }

  .gr-product-card:hover .gr-product-card__image--primary {
    transform: scale(var(--gr-image-zoom));
  }

  .gr-product-card--has-secondary:hover .gr-product-card__image--primary {
    opacity: 0;
  }

  .gr-product-card--has-secondary:hover .gr-product-card__image--secondary {
    opacity: 1;
    transform: scale(var(--gr-image-zoom));
  }

  .gr-product-card__badges {
    position: absolute;
    z-index: 3;
    top: 12px;
    left: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    pointer-events: none;
  }

  .gr-product-card__badge {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 6px 9px;
    color: var(--gr-badge-text);
    background-color: var(--gr-badge-background);
    font-size: 11px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .gr-product-card__quick-add {
    position: absolute;
    z-index: 4;
    right: 12px;
    bottom: 12px;
    left: 12px;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  .gr-product-card:hover .gr-product-card__quick-add {
    opacity: 1;
    transform: translateY(0);
  }

  .gr-product-card__form {
    margin: 0;
  }

  .gr-product-card__quick-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 46px;
    padding: 12px 16px;
    border: 0;
    border-radius: 0;
    color: var(--gr-quick-text);
    background-color: var(--gr-quick-background);
    font: inherit;
    font-size: 13px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.04em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .gr-product-card__quick-button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .gr-product-card__content {
    padding: var(--gr-card-padding);
  }

  .gr-product-card__vendor {
    margin: 0 0 6px;
    color: inherit;
    font-size: var(--gr-vendor-size);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.08em;
    opacity: 0.6;
    text-transform: uppercase;
  }

  .gr-product-card__title {
    margin: 0;
    color: inherit;
    font-size: var(--gr-title-size);
    font-weight: 800;
    line-height: 1.25;
  }

  .gr-product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .gr-product-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 7px;
    margin-top: 8px;
    color: inherit;
    font-size: var(--gr-price-size);
    font-weight: 800;
    line-height: 1.2;
  }

  .gr-product-card__price-prefix {
    font-size: 0.8em;
    font-weight: 700;
    opacity: 0.6;
  }

  .gr-product-card__price-compare {
    font-size: 0.9em;
    font-weight: 600;
    opacity: 0.45;
  }

  @media screen and (max-width: 749px) {
    .gr-products__header {
      align-items: flex-start;
      margin-bottom: 22px;
    }

    .gr-products__view-all {
      display: none;
    }

    .gr-products__grid {
      gap: var(--gr-mobile-gap);
    }

    .gr-product-card:hover {
      transform: none;
    }

    .gr-product-card__quick-add {
      position: static;
      margin: 10px var(--gr-card-padding) 0;
      opacity: 1;
      transform: none;
    }

    .gr-product-card__badges {
      top: 8px;
      left: 8px;
    }

    .gr-product-card__badge {
      min-height: 23px;
      padding: 5px 7px;
      font-size: 9px;
    }

    .gr-product-card__content {
      padding-top: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gr-product-card,
    .gr-product-card__image,
    .gr-product-card__quick-add {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GR products",
  "tag": "section",
  "class": "section-gr-products",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh in the shop"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All beside heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bottom_button",
      "label": "Show View All button underneath",
      "default": false
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All wording",
      "default": "View all"
    },
    {
      "type": "header",
      "content": "Badge wording and tags"
    },
    {
      "type": "paragraph",
      "content": "Add the matching product tag in Shopify to display a custom badge."
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold-out wording",
      "default": "SOLD OUT"
    },
    {
      "type": "text",
      "id": "sale_label",
      "label": "Sale wording",
      "default": "SALE"
    },
    {
      "type": "text",
      "id": "new_drop_label",
