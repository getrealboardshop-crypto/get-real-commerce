        },
        {
          "value": "wide",
          "label": "Wide — 16:9"
        },
        {
          "value": "landscape",
          "label": "Landscape — 3:2"
        },
        {
          "value": "square",
          "label": "Square — 1:1"
        }
      ]
    },
    {
      "type": "range",
      "id": "mobile_card_height",
      "min": 60,
      "max": 280,
      "step": 5,
      "unit": "px",
      "label": "Custom mobile card height",
      "default": 110
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 24,
      "step": 2,
