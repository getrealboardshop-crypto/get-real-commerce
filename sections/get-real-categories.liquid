<section
  id="GetRealCategories-{{ section.id }}"
  class="
    gr-categories
    gr-categories--desktop-{{ section.settings.desktop_card_ratio }}
    gr-categories--mobile-{{ section.settings.mobile_card_ratio }}
  "
>
  <div class="gr-categories__inner page-width">
    {% if section.settings.heading != blank %}
      <h2 class="gr-categories__title">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    <div class="gr-categories__grid">
      {% for block in section.blocks %}
        <a
          class="gr-categories__card"
          {% if block.settings.link != blank %}
            href="{{ block.settings.link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="gr-categories__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1000
                | image_tag:
                  class: 'gr-categories__image',
                  widths: '320, 480, 640, 800, 1000',
                  sizes: '(min-width: 990px) 25vw, 50vw',
                  loading: 'lazy'
              }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'gr-categories__placeholder' }}
            {% endif %}
          </div>

          <div class="gr-categories__overlay"></div>

          {% if block.settings.title != blank %}
            <div class="gr-categories__label">
              {{ block.settings.title | escape }}
            </div>
          {% endif %}
        </a>
      {% endfor %}
    </div>

    {% if section.settings.view_all_label != blank and section.settings.view_all_link != blank %}
      <div class="gr-categories__button-wrap">
        <a
          class="gr-categories__button"
          href="{{ section.settings.view_all_link }}"
        >
          {{ section.settings.view_all_label | escape }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  #GetRealCategories-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #GetRealCategories-{{ section.id }} .gr-categories__title {
    font-size: {{ section.settings.heading_size }}px;
  }

  #GetRealCategories-{{ section.id }} .gr-categories__grid {
    gap: {{ section.settings.card_gap }}px;
  }

  #GetRealCategories-{{ section.id }} .gr-categories__overlay {
    background-color: rgba(
      0,
      0,
      0,
      {{ section.settings.overlay_darkness | divided_by: 100.0 }}
    );
  }

  #GetRealCategories-{{ section.id }} .gr-categories__label {
    font-size: {{ section.settings.label_size }}px;
    background-color: rgba(
      0,
      0,
      0,
      {{ section.settings.label_background_opacity | divided_by: 100.0 }}
    );
  }

  #GetRealCategories-{{ section.id }}.gr-categories--desktop-custom .gr-categories__card {
    height: {{ section.settings.card_height }}px;
  }

  #GetRealCategories-{{ section.id }}.gr-categories--desktop-banner .gr-categories__card {
    height: auto;
    aspect-ratio: 2 / 1;
  }

  #GetRealCategories-{{ section.id }}.gr-categories--desktop-wide .gr-categories__card {
    height: auto;
    aspect-ratio: 16 / 9;
  }

  #GetRealCategories-{{ section.id }}.gr-categories--desktop-landscape .gr-categories__card {
    height: auto;
    aspect-ratio: 3 / 2;
  }

  #GetRealCategories-{{ section.id }}.gr-categories--desktop-square .gr-categories__card {
    height: auto;
    aspect-ratio: 1 / 1;
  }

  @media screen and (max-width: 749px) {
    #GetRealCategories-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #GetRealCategories-{{ section.id }}.gr-categories--mobile-custom .gr-categories__card {
      height: {{ section.settings.mobile_card_height }}px;
      aspect-ratio: auto;
    }

    #GetRealCategories-{{ section.id }}.gr-categories--mobile-banner .gr-categories__card {
      height: auto;
      aspect-ratio: 2 / 1;
    }

    #GetRealCategories-{{ section.id }}.gr-categories--mobile-wide .gr-categories__card {
      height: auto;
      aspect-ratio: 16 / 9;
    }

    #GetRealCategories-{{ section.id }}.gr-categories--mobile-landscape .gr-categories__card {
      height: auto;
      aspect-ratio: 3 / 2;
    }

    #GetRealCategories-{{ section.id }}.gr-categories--mobile-square .gr-categories__card {
      height: auto;
      aspect-ratio: 1 / 1;
    }
  }
{% endstyle %}

{% stylesheet %}
  .gr-categories {
    width: 100%;
  }

  .gr-categories__title {
    margin: 0 0 28px;
    color: inherit;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: center;
    text-transform: uppercase;
  }

  .gr-categories__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .gr-categories__card {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    color: #ffffff;
    text-decoration: none;
    background-color: #111111;
  }

  .gr-categories__media,
  .gr-categories__overlay {
    position: absolute;
    inset: 0;
  }

  .gr-categories__media {
    z-index: 0;
  }

  .gr-categories__overlay {
    z-index: 1;
    pointer-events: none;
  }

  .gr-categories__image,
  .gr-categories__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .gr-categories__label {
    position: absolute;
    bottom: 14px;
    left: 14px;
    z-index: 2;
    display: inline-block;
    max-width: calc(100% - 28px);
    padding: 6px 10px;
    color: #ffffff;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .gr-categories__card:hover .gr-categories__image {
    transform: scale(1.035);
  }

  .gr-categories__button-wrap {
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }

  .gr-categories__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 28px;
    border: 2px solid currentColor;
    color: inherit;
    font-size: 14px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .gr-categories__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .gr-categories__title {
      margin-bottom: 20px;
    }

    .gr-categories__label {
      bottom: 10px;
      left: 10px;
      max-width: calc(100% - 20px);
      padding: 5px 8px;
    }

    .gr-categories__button-wrap {
      margin-top: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
