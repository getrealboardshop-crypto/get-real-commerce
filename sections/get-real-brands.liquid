    {
      "type": "range",
      "id": "content_padding_horizontal",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Horizontal content padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "content_padding_bottom",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Bottom content padding",
