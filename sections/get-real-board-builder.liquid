      display: block;
    }

    .gr-builder__progress-copy span {
      display: block;
    }

    .gr-builder__progress-copy span + span {
      margin-top: 4px;
    }

    .gr-builder-step__header {
      display: block;
    }

    .gr-builder-search {
      margin-top: 18px;
    }

    .gr-builder-step__heading {
      font-size: 28px;
    }

    .gr-builder-product__body {
      padding: 12px;
    }

    .gr-builder-product__title {
      font-size: 13px;
    }

    .gr-builder-product__image {
      padding: 8px;
    }

    .gr-builder-summary__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gr-builder-summary__sticky {
      padding: 20px;
    }

    .gr-builder__nav-button {
      flex: 1 1 50%;
      padding-right: 14px;
