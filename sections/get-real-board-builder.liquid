{% comment %}
  GET REAL — BUILD MY BOARD v1.1

  - Six-step skateboard builder
  - Decks, trucks, wheels, bearings, grip tape and hardware
  - Pulls products from Shopify collections
  - Supports product variants
  - Live build summary and running total
  - Adds all selected variants through Shopify Ajax Cart API
  - Truck quantity can default to two
{% endcomment %}

{% liquid
  assign decks_collection = section.settings.decks_collection
  assign trucks_collection = section.settings.trucks_collection
  assign wheels_collection = section.settings.wheels_collection
  assign bearings_collection = section.settings.bearings_collection
  assign grip_collection = section.settings.grip_collection
  assign hardware_collection = section.settings.hardware_collection

  if decks_collection == blank
    assign decks_collection = collections['decks']
  endif

  if trucks_collection == blank
    assign trucks_collection = collections['trucks']
  endif

  if wheels_collection == blank
    assign wheels_collection = collections['wheels']
  endif

  if bearings_collection == blank
    assign bearings_collection = collections['bearings']
  endif

  if grip_collection == blank
    assign grip_collection = collections['grip-tape']
  endif

  if hardware_collection == blank
    assign hardware_collection = collections['hardware']
  endif
%}

<section
  id="GRBoardBuilder-{{ section.id }}"
  class="gr-builder"
  data-gr-board-builder
>
  <div class="gr-builder__inner page-width">


    <div class="gr-builder-launch" data-builder-launch>
      <div class="gr-builder-launch__intro">
        <p class="gr-builder__eyebrow">Get Real Setup Builder</p>
        <h1 class="gr-builder-launch__heading">How do you want to build?</h1>
        <p class="gr-builder-launch__copy">Choose a starting point. You can change any part before adding the setup to your cart.</p>
      </div>

      <div class="gr-builder-launch__paths">
        <button class="gr-builder-launch__path gr-builder-launch__path--value" type="button" data-builder-profile="value">
          <span class="gr-builder-launch__path-kicker">Lowest setup price</span>
          <strong>Best Value</strong>
          <span>Start with the $49.95 Get Real deck and our best-priced in-stock parts.</span>
          <b>Build for value →</b>
        </button>

        <button class="gr-builder-launch__path gr-builder-launch__path--accent" type="button" data-builder-profile="shop">
          <span class="gr-builder-launch__path-kicker">Recommended by Get Real</span>
          <strong>Shop Pick</strong>
          <span>Answer three quick questions and we’ll highlight the setup we would recommend in the shop.</span>
          <b>Get our recommendation →</b>
        </button>

        <button class="gr-builder-launch__path" type="button" data-builder-profile="scratch">
          <span class="gr-builder-launch__path-kicker">Your setup, your call</span>
          <strong>Build From Scratch</strong>
          <span>Browse every in-stock option and choose each part yourself.</span>
          <b>Start building →</b>
        </button>
      </div>

      <div class="gr-builder-guide" data-builder-guide hidden>
        <div class="gr-builder-guide__top">
          <div>
            <p class="gr-builder__eyebrow">Get Real setup help</p>
            <h2>Let’s build your first setup.</h2>
            <p class="gr-builder-guide__intro">This takes about 30 seconds. We’ll ask the same three questions we’d ask you in the shop.</p>
          </div>
          <button type="button" class="gr-builder-guide__cancel" data-builder-guide-cancel>Back</button>
        </div>

        <div class="gr-builder-guide__questions">
          <fieldset class="gr-builder-guide__question">
            <legend>What’s your experience level?</legend>
            <label><input type="radio" name="gr-experience-{{ section.id }}" value="new" checked><span>Never skated</span></label>
            <label><input type="radio" name="gr-experience-{{ section.id }}" value="beginner"><span>Beginner</span></label>
            <label><input type="radio" name="gr-experience-{{ section.id }}" value="intermediate"><span>Intermediate</span></label>
            <label><input type="radio" name="gr-experience-{{ section.id }}" value="advanced"><span>Advanced</span></label>
          </fieldset>

          <fieldset class="gr-builder-guide__question">
            <legend>What kind of skating are you most interested in?</legend>
            <label><input type="radio" name="gr-style-{{ section.id }}" value="street" checked><span>Street</span></label>
            <label><input type="radio" name="gr-style-{{ section.id }}" value="park"><span>Park</span></label>
            <label><input type="radio" name="gr-style-{{ section.id }}" value="transition"><span>Transition</span></label>
            <label><input type="radio" name="gr-style-{{ section.id }}" value="all"><span>Everything</span></label>
          </fieldset>

          <div class="gr-builder-guide__question gr-builder-guide__question--shoe">
            <label for="GRShoeSize-{{ section.id }}">What’s your shoe size?</label>
            <select id="GRShoeSize-{{ section.id }}" data-guide-shoe>
              <option value="small">6.5 or smaller</option>
              <option value="medium">7–9</option>
              <option value="large" selected>9.5–11</option>
              <option value="xlarge">11.5–13</option>
              <option value="xxlarge">13+</option>
            </select>
          </div>
        </div>

        <button class="gr-builder-guide__submit" type="button" data-builder-guide-submit>Get my recommendation →</button>
      </div>

      <div class="gr-builder-recommendation" data-builder-recommendation hidden>
        <button type="button" class="gr-builder-recommendation__back" data-builder-recommendation-back>← Change my answers</button>
        <div class="gr-builder-recommendation__card">
          <p class="gr-builder__eyebrow">Your Get Real recommendation</p>
          <p class="gr-builder-recommendation__lead">Based on your answers, we’d start you on:</p>
          <h2 data-builder-recommendation-range><span>8.25</span><b aria-hidden="true">–</b><span>8.5</span></h2>
          <div class="gr-builder-recommendation__reason">
            <strong data-builder-recommendation-primary>Our pick: 8.25</strong>
            <p data-builder-recommendation-copy>It gives you a great balance of control, stability, and room to progress.</p>
          </div>
          <div class="gr-builder-recommendation__options">
            <button type="button" class="gr-builder-recommendation__option gr-builder-recommendation__option--primary" data-builder-recommendation-choice="primary">
              <span data-builder-recommendation-primary-button>Start building an 8.25</span>
              <small>More responsive and versatile</small>
            </button>
            <button type="button" class="gr-builder-recommendation__option" data-builder-recommendation-choice="secondary">
              <span data-builder-recommendation-secondary-button>Show me 8.5 instead</span>
              <small>More stability and room underfoot</small>
            </button>
          </div>
          <button type="button" class="gr-builder-recommendation__all" data-builder-recommendation-all>Browse all deck sizes</button>
          <div class="gr-builder-recommendation__crew">
            <strong>Recommended by the Get Real Crew</strong>
            <span>Based on the same questions we’d ask if you walked into the shop.</span>
          </div>
        </div>
      </div>
    </div>

    <div class="gr-builder-app" data-builder-app hidden>
    <header class="gr-builder__header">
      {% if section.settings.eyebrow != blank %}
        <p class="gr-builder__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="gr-builder__heading">
          {{ section.settings.heading | escape }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="gr-builder__description">
          {{ section.settings.description | escape }}
        </p>
      {% endif %}
    </header>

    <div class="gr-builder__progress" aria-label="Build progress">
      <div class="gr-builder__stepper" data-builder-stepper>
        {% assign builder_step_labels = 'Deck,Trucks,Wheels,Bearings,Grip,Hardware' | split: ',' %}
        {% for builder_step_label in builder_step_labels %}
          <button
            class="gr-builder__stepper-item{% if forloop.first %} is-active{% endif %}"
            type="button"
            data-builder-step-jump="{{ forloop.index0 }}"
            {% unless forloop.first %}disabled{% endunless %}
          >
            <span class="gr-builder__stepper-dot" aria-hidden="true">
              <span class="gr-builder__stepper-number">{{ forloop.index }}</span>
              <span class="gr-builder__stepper-check">✓</span>
            </span>
            <span class="gr-builder__stepper-label">{{ builder_step_label }}</span>
          </button>
        {% endfor %}
      </div>
      <div class="gr-builder__progress-track">
        <span class="gr-builder__progress-fill" data-builder-progress-fill></span>
      </div>
      <div class="gr-builder__progress-copy">
        <span data-builder-step-count>Step 1 of 6</span>
        <span data-builder-progress-label>Choose your deck</span>
      </div>
    </div>

    <div class="gr-builder__layout">

      <main class="gr-builder__main">

        {% comment %}
          STEP 1 — DECKS
        {% endcomment %}
        <section
          class="gr-builder-step is-active"
          data-builder-step="0"
          data-step-name="Deck"
          data-step-heading="Choose your deck"
        >
          <div class="gr-builder-step__header">
            <div>
              <p class="gr-builder-step__number">Step 1</p>
              <h2 class="gr-builder-step__heading">Choose your deck</h2>
              <p class="gr-builder-step__copy">
                Start with the deck you want. We’ll build everything else around it.
              </p>
              <div class="gr-builder-deck-guide" data-deck-guide hidden>
                <strong data-deck-guide-title></strong>
                <span data-deck-guide-copy></span>
              </div>
            </div>

            <div class="gr-builder-search">
              <label
                class="visually-hidden"
                for="GRDeckSearch-{{ section.id }}"
              >
                Search decks
              </label>

              <input
                id="GRDeckSearch-{{ section.id }}"
                class="gr-builder-search__input"
                type="search"
                placeholder="Search decks"
                data-builder-search
              >
            </div>
          </div>

          <div class="gr-builder-products" data-builder-products>
            {% if decks_collection != blank and decks_collection.products_count > 0 %}
              {% for product in decks_collection.products limit: section.settings.products_per_step %}
                {% unless product.available %}{% continue %}{% endunless %}
                {% render 'gr-builder-product-card',
                  card_product: product,
                  step_key: 'deck',
                  step_label: 'Deck',
                  default_quantity: 1
                %}
              {% endfor %}
            {% else %}
              <div class="gr-builder-empty">
                <h3>Deck collection not connected</h3>
                <p>Select your Decks collection inside the section settings.</p>
              </div>
            {% endif %}
          </div>
        </section>

        {% comment %}
          STEP 2 — TRUCKS
        {% endcomment %}
        <section
          class="gr-builder-step"
          data-builder-step="1"
          data-step-name="Trucks"
          data-step-heading="Choose your trucks"
          hidden
        >
          <div class="gr-builder-step__header">
            <div>
              <p class="gr-builder-step__number">Step 2</p>
              <h2 class="gr-builder-step__heading">Choose your trucks</h2>
              <p class="gr-builder-step__copy">
                Truck prices may be listed individually. This builder will add
                {{ section.settings.truck_quantity }} to the cart.
              </p>
              <div class="gr-builder-truck-guide" data-truck-guide hidden>
                Recommended sizes for your <strong data-truck-guide-width></strong> deck:
                <span data-truck-guide-sizes></span>
              </div>
            </div>

            <div class="gr-builder-search">
              <label
                class="visually-hidden"
                for="GRTruckSearch-{{ section.id }}"
              >
                Search trucks
              </label>

              <input
                id="GRTruckSearch-{{ section.id }}"
                class="gr-builder-search__input"
                type="search"
                placeholder="Search trucks"
                data-builder-search
              >
            </div>
          </div>

          <div class="gr-builder-products" data-builder-products>
            {% if trucks_collection != blank and trucks_collection.products_count > 0 %}
              {% for product in trucks_collection.products limit: section.settings.products_per_step %}
                {% unless product.available %}{% continue %}{% endunless %}
                {% render 'gr-builder-product-card',
                  card_product: product,
                  step_key: 'trucks',
                  step_label: 'Trucks',
                  default_quantity: section.settings.truck_quantity
                %}
              {% endfor %}
            {% else %}
              <div class="gr-builder-empty">
                <h3>Truck collection not connected</h3>
                <p>Select your Trucks collection inside the section settings.</p>
              </div>
            {% endif %}
          </div>
        </section>

        {% comment %}
          STEP 3 — WHEELS
        {% endcomment %}
        <section
          class="gr-builder-step"
          data-builder-step="2"
          data-step-name="Wheels"
          data-step-heading="Choose your wheels"
          hidden
        >
          <div class="gr-builder-step__header">
            <div>
              <p class="gr-builder-step__number">Step 3</p>
              <h2 class="gr-builder-step__heading">Choose your wheels</h2>
              <p class="gr-builder-step__copy">
                Choose the wheel size, hardness and shape that match how you skate.
              </p>
            </div>

            <div class="gr-builder-search">
              <label
                class="visually-hidden"
                for="GRWheelSearch-{{ section.id }}"
              >
                Search wheels
              </label>

              <input
                id="GRWheelSearch-{{ section.id }}"
                class="gr-builder-search__input"
                type="search"
                placeholder="Search wheels"
                data-builder-search
              >
            </div>
          </div>

          <div class="gr-builder-products" data-builder-products>
            {% if wheels_collection != blank and wheels_collection.products_count > 0 %}
              {% for product in wheels_collection.products limit: section.settings.products_per_step %}
                {% unless product.available %}{% continue %}{% endunless %}
                {% render 'gr-builder-product-card',
                  card_product: product,
                  step_key: 'wheels',
                  step_label: 'Wheels',
                  default_quantity: 1
                %}
              {% endfor %}
            {% else %}
              <div class="gr-builder-empty">
                <h3>Wheel collection not connected</h3>
                <p>Select your Wheels collection inside the section settings.</p>
              </div>
            {% endif %}
          </div>
        </section>

        {% comment %}
          STEP 4 — BEARINGS
        {% endcomment %}
        <section
          class="gr-builder-step"
          data-builder-step="3"
          data-step-name="Bearings"
          data-step-heading="Choose your bearings"
          hidden
        >
          <div class="gr-builder-step__header">
            <div>
              <p class="gr-builder-step__number">Step 4</p>
              <h2 class="gr-builder-step__heading">Choose your bearings</h2>
              <p class="gr-builder-step__copy">
                Every skateboard needs one complete set of eight bearings.
              </p>
            </div>

            <div class="gr-builder-search">
              <label
                class="visually-hidden"
                for="GRBearingSearch-{{ section.id }}"
              >
                Search bearings
              </label>

              <input
                id="GRBearingSearch-{{ section.id }}"
                class="gr-builder-search__input"
                type="search"
                placeholder="Search bearings"
                data-builder-search
              >
            </div>
          </div>

          <div class="gr-builder-products" data-builder-products>
            {% if bearings_collection != blank and bearings_collection.products_count > 0 %}
              {% for product in bearings_collection.products limit: section.settings.products_per_step %}
                {% unless product.available %}{% continue %}{% endunless %}
                {% render 'gr-builder-product-card',
                  card_product: product,
                  step_key: 'bearings',
                  step_label: 'Bearings',
                  default_quantity: 1
                %}
              {% endfor %}
            {% else %}
              <div class="gr-builder-empty">
                <h3>Bearing collection not connected</h3>
                <p>Select your Bearings collection inside the section settings.</p>
              </div>
            {% endif %}
          </div>
        </section>

        {% comment %}
          STEP 5 — GRIP TAPE
        {% endcomment %}
        <section
          class="gr-builder-step"
          data-builder-step="4"
          data-step-name="Grip Tape"
          data-step-heading="Choose your grip tape"
          hidden
        >
          <div class="gr-builder-step__header">
            <div>
              <p class="gr-builder-step__number">Step 5</p>
              <h2 class="gr-builder-step__heading">Choose your grip tape</h2>
              <p class="gr-builder-step__copy">
                Pick classic black grip or add some personality to the top of your board.
              </p>
            </div>

            <div class="gr-builder-search">
              <label
                class="visually-hidden"
                for="GRGripSearch-{{ section.id }}"
              >
                Search grip tape
              </label>

              <input
                id="GRGripSearch-{{ section.id }}"
                class="gr-builder-search__input"
                type="search"
                placeholder="Search grip tape"
                data-builder-search
              >
            </div>
          </div>

          <div class="gr-builder-products" data-builder-products>
            {% if grip_collection != blank and grip_collection.products_count > 0 %}
              {% for product in grip_collection.products limit: section.settings.products_per_step %}
                {% unless product.available %}{% continue %}{% endunless %}
                {% render 'gr-builder-product-card',
                  card_product: product,
                  step_key: 'grip',
                  step_label: 'Grip Tape',
                  default_quantity: 1
                %}
              {% endfor %}
            {% else %}
              <div class="gr-builder-empty">
                <h3>Grip Tape collection not connected</h3>
                <p>Select your Grip Tape collection inside the section settings.</p>
              </div>
            {% endif %}
          </div>
        </section>

        {% comment %}
          STEP 6 — HARDWARE
        {% endcomment %}
        <section
          class="gr-builder-step"
          data-builder-step="5"
          data-step-name="Hardware"
          data-step-heading="Choose your hardware"
          hidden
        >
          <div class="gr-builder-step__header">
            <div>
              <p class="gr-builder-step__number">Step 6</p>
              <h2 class="gr-builder-step__heading">Choose your hardware</h2>
              <p class="gr-builder-step__copy">
                Finish the setup with hardware to mount the trucks to your deck.
              </p>
            </div>

            <div class="gr-builder-search">
              <label
                class="visually-hidden"
                for="GRHardwareSearch-{{ section.id }}"
              >
                Search hardware
              </label>

              <input
                id="GRHardwareSearch-{{ section.id }}"
                class="gr-builder-search__input"
                type="search"
                placeholder="Search hardware"
                data-builder-search
              >
            </div>
          </div>

          <div class="gr-builder-products" data-builder-products>
            {% if hardware_collection != blank and hardware_collection.products_count > 0 %}
              {% for product in hardware_collection.products limit: section.settings.products_per_step %}
                {% unless product.available %}{% continue %}{% endunless %}
                {% render 'gr-builder-product-card',
                  card_product: product,
                  step_key: 'hardware',
                  step_label: 'Hardware',
                  default_quantity: 1
                %}
              {% endfor %}
            {% else %}
              <div class="gr-builder-empty">
                <h3>Hardware collection not connected</h3>
                <p>Select your Hardware collection inside the section settings.</p>
              </div>
            {% endif %}
          </div>
        </section>

        <div class="gr-builder__navigation gr-builder__navigation--sticky">
          <button
            class="gr-builder__nav-button gr-builder__nav-button--back"
            type="button"
            data-builder-back
            disabled
          >
            <span aria-hidden="true">←</span>
            Back
          </button>

          <button
            class="gr-builder__nav-button gr-builder__nav-button--next"
            type="button"
            data-builder-next
            disabled
          >
            Next step
            <span aria-hidden="true">→</span>
          </button>
        </div>

      </main>

      <aside class="gr-builder-summary">
        <div class="gr-builder-summary__sticky">
          <div class="gr-builder-summary__header">
            <p class="gr-builder-summary__eyebrow">Live build</p>
            <h2 class="gr-builder-summary__heading">Your setup</h2>
          </div>

          <div class="gr-builder-summary__items">

            {% assign summary_steps = 'deck,trucks,wheels,bearings,grip,hardware' | split: ',' %}
            {% assign summary_labels = 'Deck,Trucks,Wheels,Bearings,Grip Tape,Hardware' | split: ',' %}

            {% for summary_step in summary_steps %}
              <div
                class="gr-builder-summary-item"
                data-summary-item="{{ summary_step }}"
              >
                <div class="gr-builder-summary-item__image-wrap">
                  <img
                    class="gr-builder-summary-item__image"
                    src=""
                    alt=""
                    width="64"
                    height="64"
                    loading="lazy"
                    data-summary-image
                    hidden
                  >

                  <span
                    class="gr-builder-summary-item__placeholder"
                    data-summary-placeholder
                  >
                    {{ forloop.index }}
                  </span>
                </div>

                <div class="gr-builder-summary-item__content">
                  <span class="gr-builder-summary-item__label">
                    {{ summary_labels[forloop.index0] }}
                  </span>

                  <strong
                    class="gr-builder-summary-item__title"
                    data-summary-title
                  >
                    Not selected
                  </strong>

                  <span
                    class="gr-builder-summary-item__variant"
                    data-summary-variant
                  ></span>
                </div>

                <button
                  class="gr-builder-summary-item__change"
                  type="button"
                  data-summary-change="{{ forloop.index0 }}"
                  hidden
                >
                  Change
                </button>
              </div>
            {% endfor %}

          </div>

          <div class="gr-builder-summary__total">
            <span>Total</span>
            <strong data-builder-total>
              {{ 0 | money }}
            </strong>
          </div>

          <p class="gr-builder-summary__truck-note">
            Truck total reflects a quantity of
            {{ section.settings.truck_quantity }}.
          </p>

          <div class="gr-builder-summary__rewards">
            <strong>Complete setup reward</strong>
            <span>Free shipping + free Get Real stickers</span>
          </div>

          <label class="gr-builder-summary__assembly">
            <input type="checkbox" data-builder-assembly>
            <span>
              <strong>Request assembly + grip application</strong>
              <small>We only assemble and apply grip when you request it.</small>
            </span>
          </label>

          <button
            class="gr-builder-summary__add"
            type="button"
            data-builder-add-all
            disabled
          >
            <span data-builder-add-label>Add complete setup</span>
            <span aria-hidden="true">→</span>
          </button>

          <div
            class="gr-builder-summary__message"
            role="status"
            aria-live="polite"
            data-builder-message
          ></div>
        </div>
      </aside>

    </div>
  </div>
    </div>

  <div
    class="gr-builder-modal"
    data-builder-modal
    aria-hidden="true"
    hidden
  >
    <button
      class="gr-builder-modal__backdrop"
      type="button"
      aria-label="Close product details"
      data-builder-modal-close
    ></button>

    <div
      class="gr-builder-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="GRBuilderModalTitle-{{ section.id }}"
    >
      <button
        class="gr-builder-modal__x"
        type="button"
        aria-label="Close product details"
        data-builder-modal-close
      >
        <span aria-hidden="true">×</span>
      </button>

      <div class="gr-builder-modal__media">
        <div class="gr-builder-modal__main-image-wrap">
          <button
            class="gr-builder-modal__arrow gr-builder-modal__arrow--previous"
            type="button"
            aria-label="Previous image"
            data-builder-modal-previous
          >
            <span aria-hidden="true">‹</span>
          </button>

          <img
            class="gr-builder-modal__main-image"
            src=""
            alt=""
            width="900"
            height="900"
            data-builder-modal-image
          >

          <button
            class="gr-builder-modal__arrow gr-builder-modal__arrow--next"
            type="button"
            aria-label="Next image"
            data-builder-modal-next
          >
            <span aria-hidden="true">›</span>
          </button>
        </div>

        <div
          class="gr-builder-modal__thumbnails"
          data-builder-modal-thumbnails
        ></div>
      </div>

      <div class="gr-builder-modal__content">
        <p class="gr-builder-modal__vendor" data-builder-modal-vendor></p>

        <h2
          id="GRBuilderModalTitle-{{ section.id }}"
          class="gr-builder-modal__title"
          data-builder-modal-title
        ></h2>

        <div class="gr-builder-modal__price-row">
          <strong class="gr-builder-modal__price" data-builder-modal-price></strong>
          <span class="gr-builder-modal__quantity" data-builder-modal-quantity></span>
        </div>

        <div class="gr-builder-modal__facts">
          <div class="gr-builder-modal__fact" data-builder-modal-variant-wrap>
            <span class="gr-builder-modal__fact-label">Selected option</span>
            <strong data-builder-modal-variant></strong>
          </div>

          <div class="gr-builder-modal__fact" data-builder-modal-recommendation-wrap hidden>
            <span class="gr-builder-modal__fact-label">Recommended for your deck</span>
            <strong data-builder-modal-recommendation></strong>
          </div>
        </div>

        <p class="gr-builder-modal__description" data-builder-modal-description></p>

        <button
          class="gr-builder-modal__choose-button"
          type="button"
          data-builder-modal-choose
        >
          Choose this
        </button>

        <a
          class="gr-builder-modal__product-link"
          href="#"
          target="_blank"
          rel="noopener"
          data-builder-modal-product-link
        >
          View product page ↗
        </a>

        <button
          class="gr-builder-modal__close-button"
          type="button"
          data-builder-modal-close
        >
          Close
        </button>
      </div>
    </div>
  </div>

</section>

{% style %}
  #GRBoardBuilder-{{ section.id }} {
    --gr-builder-bg: {{ section.settings.background_color }};
    --gr-builder-text: {{ section.settings.text_color }};
    --gr-builder-muted: {{ section.settings.muted_text_color }};
    --gr-builder-card: {{ section.settings.card_background }};
    --gr-builder-card-border: {{ section.settings.card_border_color }};
    --gr-builder-summary: {{ section.settings.summary_background }};
    --gr-builder-summary-text: {{ section.settings.summary_text_color }};
    --gr-builder-accent: {{ section.settings.accent_color }};
    --gr-builder-button-text: {{ section.settings.button_text_color }};

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    color: var(--gr-builder-text);
    background: var(--gr-builder-bg);
  }

  #GRBoardBuilder-{{ section.id }} .gr-builder__heading {
    font-size: {{ section.settings.heading_size }}px;
  }

  #GRBoardBuilder-{{ section.id }} .gr-builder-products {
    grid-template-columns: repeat(
      {{ section.settings.desktop_columns }},
      minmax(0, 1fr)
    );
  }

  @media screen and (max-width: 749px) {
    #GRBoardBuilder-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #GRBoardBuilder-{{ section.id }} .gr-builder__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #GRBoardBuilder-{{ section.id }} .gr-builder-products {
      grid-template-columns: repeat(
        {{ section.settings.mobile_columns }},
        minmax(0, 1fr)
      );
    }
  }
{% endstyle %}

{% stylesheet %}
  .gr-builder {
    width: 100%;
  }

  .gr-builder__header {
    max-width: 900px;
    margin-bottom: 36px;
  }

  .gr-builder__eyebrow {
    margin: 0 0 14px;
    color: var(--gr-builder-accent);
    font-size: 12px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .gr-builder__heading {
    margin: 0;
    color: inherit;
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  .gr-builder__description {
    max-width: 680px;
    margin: 20px 0 0;
    color: var(--gr-builder-muted);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.5;
  }

  .gr-builder__progress {
    margin-bottom: 32px;
  }

  .gr-builder__progress-track {
    width: 100%;
    height: 5px;
    overflow: hidden;
    background: var(--gr-builder-card-border);
  }

  .gr-builder__progress-fill {
    display: block;
    width: 16.6667%;
    height: 100%;
    background: var(--gr-builder-accent);
    transition: width 240ms ease;
  }

  .gr-builder__progress-copy {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 11px;
    color: var(--gr-builder-muted);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .gr-builder__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    align-items: start;
    gap: 32px;
  }

  .gr-builder__main {
    min-width: 0;
  }

  .gr-builder-step[hidden] {
    display: none;
  }

  .gr-builder-step__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 24px;
  }

  .gr-builder-step__number {
    margin: 0 0 9px;
    color: var(--gr-builder-accent);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .gr-builder-step__heading {
    margin: 0;
    color: inherit;
    font-size: 34px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .gr-builder-step__copy {
    max-width: 620px;
    margin: 12px 0 0;
    color: var(--gr-builder-muted);
    font-size: 14px;
    line-height: 1.45;
  }

  .gr-builder-search {
    flex: 0 0 240px;
  }

  .gr-builder-search__input {
    width: 100%;
    height: 48px;
    padding: 0 16px;
    color: var(--gr-builder-text);
    background: var(--gr-builder-bg);
    border: 1px solid var(--gr-builder-card-border);
    border-radius: 0;
    box-shadow: none;
    font: inherit;
    font-size: 14px;
  }

  .gr-builder-search__input:focus {
    border-color: var(--gr-builder-accent);
    outline: 2px solid transparent;
  }

  .gr-builder-products {
    display: grid;
    gap: 14px;
  }

  .gr-builder-product {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: var(--gr-builder-card);
    border: 1px solid var(--gr-builder-card-border);
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .gr-builder-product:hover {
    border-color: var(--gr-builder-accent);
    transform: translateY(-2px);
  }

  .gr-builder-product.is-selected {
    border: 2px solid var(--gr-builder-accent);
    box-shadow: inset 0 0 0 2px var(--gr-builder-bg);
  }

  .gr-builder-product__image-wrap {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #f6f6f6;
  }

  .gr-builder-product__image,
  .gr-builder-product__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gr-builder-product__image {
    padding: 12px;
    transition: transform 260ms ease;
  }

  .gr-builder-product:hover .gr-builder-product__image {
    transform: scale(1.035);
  }

  .gr-builder-product__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    padding: 7px 9px;
    color: #ffffff;
    background: #111111;
    font-size: 10px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .gr-builder-product__profile-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 3;
    padding: 7px 9px;
    color: #111;
    background: var(--gr-builder-accent);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .gr-builder-product.is-profile-pick { order: -1; border-color: var(--gr-builder-accent); }

  .gr-builder-product__body {
    padding: 15px;
  }

  .gr-builder-product__vendor {
    display: block;
    margin-bottom: 6px;
    color: var(--gr-builder-muted);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .gr-builder-product__title {
    margin: 0;
    color: inherit;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.25;
  }

  .gr-builder-product__price {
    display: block;
    margin-top: 8px;
    color: inherit;
    font-size: 14px;
    font-weight: 800;
  }

  .gr-builder-product__variant-wrap {
    margin-top: 12px;
  }

  .gr-builder-product__variant-label {
    display: block;
    margin-bottom: 6px;
    color: var(--gr-builder-muted);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .gr-builder-product__variant {
    width: 100%;
    height: 42px;
    padding: 0 34px 0 12px;
    color: var(--gr-builder-text);
    background: var(--gr-builder-bg);
    border: 1px solid var(--gr-builder-card-border);
    border-radius: 0;
    font: inherit;
    font-size: 12px;
  }

  .gr-builder-product__select {
    display: flex;
    width: 100%;
    min-height: 45px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 12px;
    padding: 10px 13px;
    color: var(--gr-builder-button-text);
    background: var(--gr-builder-accent);
    border: 2px solid var(--gr-builder-accent);
    font: inherit;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 180ms ease,
      background 180ms ease;
  }

  .gr-builder-product__select:hover {
    color: var(--gr-builder-accent);
    background: transparent;
  }

  .gr-builder-product.is-selected .gr-builder-product__select {
    color: #ffffff;
    background: #111111;
    border-color: #111111;
  }

  .gr-builder-product__select[disabled] {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .gr-builder-empty {
    grid-column: 1 / -1;
    padding: 40px;
    text-align: center;
    border: 1px solid var(--gr-builder-card-border);
  }

  .gr-builder-empty h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .gr-builder-empty p {
    margin: 10px 0 0;
    color: var(--gr-builder-muted);
  }

  .gr-builder__navigation {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 28px;
  }

  .gr-builder__nav-button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 13px 24px;
    border: 2px solid var(--gr-builder-text);
    font: inherit;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .gr-builder__nav-button--back {
    color: var(--gr-builder-text);
    background: transparent;
  }

  .gr-builder__nav-button--next {
    margin-left: 0;
    color: var(--gr-builder-bg);
    background: var(--gr-builder-text);
  }

  .gr-builder__nav-button[disabled] {
    cursor: not-allowed;
    opacity: 0.35;
  }

  .gr-builder-summary {
    min-width: 0;
    color: var(--gr-builder-summary-text);
  }

  .gr-builder-summary__sticky {
    position: sticky;
    top: 24px;
    padding: 26px;
    background: var(--gr-builder-summary);
  }

  .gr-builder-summary__header {
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .gr-builder-summary__eyebrow {
    margin: 0 0 8px;
    color: var(--gr-builder-accent);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .gr-builder-summary__heading {
    margin: 0;
    color: inherit;
    font-size: 28px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .gr-builder-summary__items {
    padding: 8px 0;
  }

  .gr-builder-summary-item {
    display: grid;
    grid-template-columns: 50px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-height: 70px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .gr-builder-summary-item__image-wrap {
    display: flex;
    width: 50px;
    height: 50px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #ffffff;
  }

  .gr-builder-summary-item__image {
    width: 100%;
    height: 100%;
    padding: 4px;
    object-fit: contain;
  }

  .gr-builder-summary-item__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.08);
    font-size: 13px;
    font-weight: 900;
  }

  .gr-builder-summary-item__content {
    min-width: 0;
  }

  .gr-builder-summary-item__label {
    display: block;
    color: rgba(255, 255, 255, 0.55);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .gr-builder-summary-item__title {
    display: block;
    overflow: hidden;
    margin-top: 3px;
    color: inherit;
    font-size: 12px;
    line-height: 1.3;
    text-overflow: ellipsis;
  }

  .gr-builder-summary-item__variant {
    display: block;
    overflow: hidden;
    margin-top: 2px;
    color: rgba(255, 255, 255, 0.55);
    font-size: 10px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gr-builder-summary-item__change {
    padding: 0;
    color: var(--gr-builder-accent);
    background: transparent;
    border: 0;
    font: inherit;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .gr-builder-summary__total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0 12px;
    color: inherit;
    font-size: 18px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .gr-builder-summary__truck-note {
    margin: 0 0 16px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 10px;
    line-height: 1.4;
  }

  .gr-builder-summary__rewards {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 16px 0;
    padding: 14px;
    color: #111;
    background: var(--gr-builder-accent);
    text-transform: uppercase;
  }

  .gr-builder-summary__rewards strong { font-size: 11px; letter-spacing: .08em; }
  .gr-builder-summary__rewards span { font-size: 13px; font-weight: 900; }
  .gr-builder-summary__assembly { display:flex;gap:11px;align-items:flex-start;margin:0 0 16px;cursor:pointer; }
  .gr-builder-summary__assembly input { width:18px;height:18px;margin:2px 0 0;accent-color:var(--gr-builder-accent); }
  .gr-builder-summary__assembly span { display:flex;flex-direction:column;gap:4px; }
  .gr-builder-summary__assembly strong { color:inherit;font-size:11px;text-transform:uppercase; }
  .gr-builder-summary__assembly small { color:rgba(255,255,255,.66);font-size:10px;line-height:1.35; }

  .gr-builder-summary__add {
    display: flex;
    width: 100%;
    min-height: 54px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 18px;
    color: var(--gr-builder-button-text);
    background: var(--gr-builder-accent);
    border: 2px solid var(--gr-builder-accent);
    font: inherit;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .gr-builder-summary__add[disabled] {
    cursor: not-allowed;
    opacity: 0.4;
  }

  .gr-builder-summary__message {
    min-height: 20px;
    margin-top: 12px;
    color: inherit;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.4;
  }

  .gr-builder-product[hidden] {
    display: none;
  }

  @media screen and (max-width: 1100px) {
    .gr-builder__layout {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 22px;
    }
  }

  @media screen and (max-width: 989px) {
    .gr-builder__layout {
      grid-template-columns: 1fr;
    }

    .gr-builder-summary {
      order: -1;
    }

    .gr-builder-summary__sticky {
      position: static;
    }

    .gr-builder-summary__items {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    .gr-builder-summary-item {
