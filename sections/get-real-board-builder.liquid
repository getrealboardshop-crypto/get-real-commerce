  .gr-builder-recommendation__option{min-height:112px;padding:20px;text-align:left;color:#fff;background:transparent;border:1px solid rgba(255,255,255,.35);font:inherit;cursor:pointer;transition:transform .18s ease,border-color .18s ease,background .18s ease}
  .gr-builder-recommendation__option:hover{transform:translateY(-2px);border-color:var(--gr-builder-accent)}
