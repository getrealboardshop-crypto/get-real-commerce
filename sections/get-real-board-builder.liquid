  .gr-builder-recommendation__crew span{max-width:430px;color:rgba(255,255,255,.58);font-size:11px;line-height:1.45;text-align:right}
  .gr-builder-deck-guide{margin-top:18px;padding:14px 16px;background:#fff7e8;border-left:4px solid var(--gr-builder-accent)}
  .gr-builder-deck-guide strong,.gr-builder-deck-guide span{display:block}
  .gr-builder-deck-guide strong{font-size:14px}.gr-builder-deck-guide span{margin-top:4px;color:var(--gr-builder-muted);font-size:12px}
  .gr-builder-product.is-guided-match{border-color:var(--gr-builder-accent);box-shadow:0 0 0 2px var(--gr-builder-accent)}
  .gr-builder-product.is-guided-match:before{content:'Recommended';position:absolute;top:10px;right:10px;z-index:4;padding:7px 9px;color:#111;background:var(--gr-builder-accent);font-size:9px;font-weight:900;letter-spacing:.06em;text-transform:uppercase}
  @media(max-width:749px){.gr-builder-launch__paths,.gr-builder-guide__questions,.gr-builder-recommendation__options{grid-template-columns:1fr}.gr-builder-launch__path{min-height:250px;padding:24px}.gr-builder-launch__path-kicker{margin-bottom:45px}.gr-builder-guide{padding:22px}.gr-builder-guide__top h2{font-size:28px}.gr-builder-recommendation__card{padding:28px 22px}.gr-builder-recommendation__card h2{font-size:62px}.gr-builder-recommendation__crew{display:block}.gr-builder-recommendation__crew span{display:block;margin-top:8px;text-align:left}.gr-builder-guide__question--shoe{grid-column:auto;width:100%}}

  @media (prefers-reduced-motion: reduce) {
    .gr-builder__progress-fill,
