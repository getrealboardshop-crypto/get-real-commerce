<script>
(() => {
  const section=document.querySelector('#GRBoardBuilder-{{ section.id }}');
  if(!section||section.dataset.builderReady==='true')return;
  section.dataset.builderReady='true';

  const launch=section.querySelector('[data-builder-launch]');
  const app=section.querySelector('[data-builder-app]');
  const paths=section.querySelector('.gr-builder-launch__paths');
  const guide=section.querySelector('[data-builder-guide]');
  const recommendationScreen=section.querySelector('[data-builder-recommendation]');
  const recommendationRange=section.querySelector('[data-builder-recommendation-range]');
  const recommendationPrimary=section.querySelector('[data-builder-recommendation-primary]');
  const recommendationCopy=section.querySelector('[data-builder-recommendation-copy]');
  const recommendationPrimaryButton=section.querySelector('[data-builder-recommendation-primary-button]');
  const recommendationSecondaryButton=section.querySelector('[data-builder-recommendation-secondary-button]');
  const deckGuide=section.querySelector('[data-deck-guide]');
  const deckGuideTitle=section.querySelector('[data-deck-guide-title]');
  const deckGuideCopy=section.querySelector('[data-deck-guide-copy]');
  let guidedWidth=null;

  const steps=[...section.querySelectorAll('[data-builder-step]')];
  const keys=['deck','trucks','wheels','bearings','grip','hardware'];
  const selections=Object.fromEntries(keys.map(k=>[k,null]));
  const stepper=[...section.querySelectorAll('[data-builder-step-jump]')];
  const truckMap={
    slappy:{'8':'8.0','8.25':'8.25','8.5':'8.5','8.75':'8.75','9':'9.0'},
    independent:{'7.75':'129','8':'139','8.25':'144','8.5':'149','8.75':'159','9':'169','10':'215'},
    ace:{'8':'33','8.25':'44','8.5':'55','8.75':'60','9':'66','9.5':'77'},
    thunder:{'8':'147','8.25':'148','8.5':'149','8.75':'151','9':'161'}
  };

  let current=0,adding=false,deckWidth=null;
  const progressFill=section.querySelector('[data-builder-progress-fill]');
  const stepCount=section.querySelector('[data-builder-step-count]');
  const progressLabel=section.querySelector('[data-builder-progress-label]');
  const back=section.querySelector('[data-builder-back]');
  const next=section.querySelector('[data-builder-next]');
  const addAll=section.querySelector('[data-builder-add-all]');
  const addLabel=section.querySelector('[data-builder-add-label]');
  const totalEl=section.querySelector('[data-builder-total]');
  const message=section.querySelector('[data-builder-message]');
  const assemblyRequest=section.querySelector('[data-builder-assembly]');
  const truckGuide=section.querySelector('[data-truck-guide]');
  const modal=section.querySelector('[data-builder-modal]');
  const modalImage=section.querySelector('[data-builder-modal-image]');
  const modalThumbs=section.querySelector('[data-builder-modal-thumbnails]');
  const modalVendor=section.querySelector('[data-builder-modal-vendor]');
  const modalTitle=section.querySelector('[data-builder-modal-title]');
  const modalPrice=section.querySelector('[data-builder-modal-price]');
  const modalQuantity=section.querySelector('[data-builder-modal-quantity]');
  const modalVariantWrap=section.querySelector('[data-builder-modal-variant-wrap]');
  const modalVariant=section.querySelector('[data-builder-modal-variant]');
  const modalRecommendationWrap=section.querySelector('[data-builder-modal-recommendation-wrap]');
  const modalRecommendation=section.querySelector('[data-builder-modal-recommendation]');
  const modalDescription=section.querySelector('[data-builder-modal-description]');
  const modalProductLink=section.querySelector('[data-builder-modal-product-link]');
  const modalChoose=section.querySelector('[data-builder-modal-choose]');
  const modalPrevious=section.querySelector('[data-builder-modal-previous]');
  const modalNext=section.querySelector('[data-builder-modal-next]');
  let modalMedia=[];
  let modalMediaIndex=0;
  let modalReturnFocus=null;
  let modalActiveCard=null;

  const money=c=>window.Shopify&&typeof window.Shopify.formatMoney==='function'
    ?window.Shopify.formatMoney(c)
    :new Intl.NumberFormat(document.documentElement.lang||'en-US',{style:'currency',currency:'{{ cart.currency.iso_code | default: shop.currency }}'}).format(c/100);

  const widthFrom=value=>{
    const m=String(value||'').match(/(?:^|[^0-9])(10(?:\.0)?|9\.5|9(?:\.0)?|8\.75|8\.5|8\.38|8\.25|8\.125|8(?:\.0)?|7\.75)(?=[^0-9]|$)/i);
    if(!m)return null;
    const n=Number(m[1]);
    if(n===8.125||n===8.38)return '8.25';
    return String(n);
  };

  let buildProfile='scratch';
  const clearProfilePicks=()=>section.querySelectorAll('[data-builder-product]').forEach(card=>{
    card.classList.remove('is-profile-pick');
    const badge=card.querySelector('[data-builder-profile-badge]');
    if(badge){badge.hidden=true;badge.textContent='';}
  });
  const markProfilePick=(card,label)=>{
    if(!card)return;
    card.classList.add('is-profile-pick');
    const badge=card.querySelector('[data-builder-profile-badge]');
    if(badge){badge.textContent=label;badge.hidden=false;}
  };
  const lowestPricedCard=cards=>cards.reduce((best,card)=>{
    const select=card.querySelector('[data-builder-variant-select]');
    const prices=select?[...select.options].filter(option=>!option.disabled).map(option=>Number(option.dataset.price)):[Number(card.dataset.price)];
    const price=Math.min(...prices.filter(Number.isFinite));
    return !best||price<best.price?{card,price}:best;
  },null)?.card;
  const applyBuildProfile=profile=>{
    buildProfile=profile||'scratch';
    clearProfilePicks();
    if(buildProfile==='scratch')return;
    const profileLabel=buildProfile==='value'?'Best value':'Shop pick';
    steps.forEach((step,index)=>{
      const cards=[...step.querySelectorAll('[data-builder-product]')].filter(card=>card.dataset.available==='true');
      let pick=null;
      if(buildProfile==='value'&&index===0){
        pick=cards.find(card=>card.dataset.productHandle==='get-real-jazz-solo-deck'||/get real jazz solo/i.test(card.dataset.productTitle));
      }
      if(buildProfile==='shop'){
        const shopTerms=[/get real|real team|baker/i,/slappy|independent/i,/spitfire formula four/i,/bones reds|bronson g2/i,/mob grip|pepper g5/i,/independent genuine parts/i];
        pick=cards.find(card=>shopTerms[index]?.test(`${card.dataset.vendor} ${card.dataset.productTitle} ${card.dataset.productTags}`));
      }
      markProfilePick(pick||lowestPricedCard(cards),profileLabel);
    });
  };
  const startApp=(profile='scratch')=>{launch.hidden=true;app.hidden=false;applyBuildProfile(profile);showStep(0,false);window.scrollTo({top:section.getBoundingClientRect().top+window.scrollY-12,behavior:'smooth'});};
  const guideValue=name=>section.querySelector(`input[name="${name}-{{ section.id }}"]:checked`)?.value||'';
  const recommendationData=()=>{
    const shoe=section.querySelector('[data-guide-shoe]').value;
    const style=guideValue('gr-style');
    const experience=guideValue('gr-experience');
    const map={
      small:{primary:'7.75',secondary:'8.0',range:'7.75–8.0'},
      medium:{primary:'8.0',secondary:'8.25',range:'8.0–8.25'},
      large:{primary:'8.25',secondary:'8.5',range:'8.25–8.5'},
      xlarge:{primary:'8.5',secondary:'8.75',range:'8.5–8.75'},
      xxlarge:{primary:'8.75',secondary:'9.0',range:'8.75–9.0'}
    };
    const data={...map[shoe]};
    if(style==='transition'){
      data.primary=data.secondary;
      data.secondary=shoe==='xxlarge'?'9.5':String(Number(data.secondary)+.25);
      data.range=`${data.primary}–${data.secondary}`;
    }
    const styleCopy={
      street:'a responsive all-around setup for street skating',
      park:'a balanced setup that works well at the park',
      transition:'extra stability and room underfoot for transition',
      all:'a versatile setup that can handle a little of everything'
    };
    const experienceCopy={
      new:'easy to learn on without boxing you in as you progress',
      beginner:'stable enough to build confidence while staying responsive',
      intermediate:'a dependable size range with room to fine-tune your preference',
      advanced:'a strong starting point that you can adjust to your exact preference'
    };
    data.copy=`This range gives you ${styleCopy[style]||styleCopy.all}. It is ${experienceCopy[experience]||experienceCopy.beginner}.`;
    return data;
  };

  const applyGuidedRecommendation=(width)=>{
    guidedWidth=width;
    const secondary=section.dataset.guidedSecondary||'';
    deckGuide.hidden=false;
    deckGuideTitle.textContent=`Get Real recommendation: ${guidedWidth}${secondary?`–${secondary}`:''}`;
    deckGuideCopy.textContent=`We highlighted ${guidedWidth} decks below. You can still choose any deck you want.`;
    steps[0].querySelectorAll('[data-builder-product]').forEach(card=>{
      card.classList.remove('is-guided-match');
      const select=card.querySelector('[data-builder-variant-select]');
      let match=false;
      if(select){[...select.options].forEach((option,index)=>{if(widthFrom(option.dataset.variantTitle)===guidedWidth&&option.dataset.available==='true'){if(!match)select.selectedIndex=index;match=true;}});}
      if(!match)match=widthFrom(card.dataset.variantTitle)===guidedWidth||widthFrom(card.dataset.productTitle)===guidedWidth;
      card.classList.toggle('is-guided-match',match);
      if(match&&select)select.dispatchEvent(new Event('change',{bubbles:true}));
    });
  };

  const showRecommendation=()=>{
    const data=recommendationData();
    section.dataset.guidedPrimary=data.primary;
    section.dataset.guidedSecondary=data.secondary;
    const rangeParts=data.range.split(/[–-]/).map(part=>part.trim());
    recommendationRange.innerHTML=`<span>${rangeParts[0]||data.primary}</span><b aria-hidden="true">–</b><span>${rangeParts[1]||data.secondary}</span>`;
    recommendationPrimary.textContent=`Our pick: ${data.primary}`;
    recommendationCopy.textContent=data.copy;
    recommendationPrimaryButton.textContent=`Start building a ${data.primary}`;
    recommendationSecondaryButton.textContent=`Show me ${data.secondary} instead`;
    guide.hidden=true;
    recommendationScreen.hidden=false;
    recommendationScreen.scrollIntoView({behavior:'smooth',block:'start'});
  };

  const beginRecommendedBuild=(width,browseAll=false)=>{
    recommendationScreen.hidden=true;
    startApp('shop');
    if(!browseAll)applyGuidedRecommendation(width);
  };

  const brandOf=card=>{
    const value=`${card.dataset.vendor||''} ${card.dataset.productTitle||''}`.toLowerCase();
    return Object.keys(truckMap).find(b=>value.includes(b))||null;
  };

  const recommended=card=>{
    const brand=brandOf(card);
    return brand&&deckWidth?truckMap[brand][deckWidth]||null:null;
  };

  const optionMatches=(option,size)=>{
    if(!size)return false;
    const escaped=size.replace('.','\\.');
    return new RegExp(`(^|[^0-9])${escaped}(?=[^0-9]|$)`,'i').test(`${option.dataset.variantTitle||''} ${option.textContent||''}`);
  };

  const applyTruckRecommendations=()=>{
    const widthEl=section.querySelector('[data-truck-guide-width]');
    const sizesEl=section.querySelector('[data-truck-guide-sizes]');
    if(!deckWidth){if(truckGuide)truckGuide.hidden=true;return;}
    const labels=new Map();
    section.querySelectorAll('[data-builder-product][data-step-key="trucks"]').forEach(card=>{
      const size=recommended(card),select=card.querySelector('[data-builder-variant-select]'),badge=card.querySelector('[data-builder-recommendation]');
      if(badge){badge.textContent=size?`${size} recommended`:'';badge.classList.toggle('is-visible',!!size);}
      card.hidden=false;
      card.dataset.compatible='true';
      if(!size)return;
      const brand=brandOf(card);
      if(!labels.has(brand))labels.set(brand,`${brand[0].toUpperCase()+brand.slice(1)} ${size}`);
      if(select){
        [...select.options].forEach(option=>{
          const base=option.dataset.baseLabel||option.textContent.replace(/\s+\(Recommended\)$/i,'');
          option.dataset.baseLabel=base;
          const matches=optionMatches(option,size);
          option.disabled=!matches;
          option.textContent=matches?`${base} (Compatible)`:base;
        });
        const match=[...select.options].find(o=>!o.disabled&&optionMatches(o,size));
        if(match){select.value=match.value;select.dispatchEvent(new Event('change',{bubbles:true}));}
        card.hidden=!match;
        card.dataset.compatible=match?'true':'false';
      }
    });
    if(truckGuide&&widthEl&&sizesEl){
      widthEl.textContent=deckWidth;
      sizesEl.textContent=[...labels.values()].join(' · ');
      truckGuide.hidden=!labels.size;
    }
  };

  const renderModalMedia=()=>{
    const media=modalMedia[modalMediaIndex]||modalMedia[0];
    if(!media)return;
    modalImage.src=media.src;
    modalImage.alt=media.alt||modalTitle.textContent||'Product image';
    modalThumbs.querySelectorAll('[data-builder-modal-thumbnail]').forEach((button,index)=>button.classList.toggle('is-active',index===modalMediaIndex));
    const multiple=modalMedia.length>1;
    modalPrevious.hidden=!multiple;
    modalNext.hidden=!multiple;
  };

  const closeModal=()=>{
    if(!modal||modal.hidden)return;
    modal.hidden=true;
    modal.setAttribute('aria-hidden','true');
    document.body.classList.remove('gr-builder-modal-open');
    if(modalReturnFocus)modalReturnFocus.focus();
    modalActiveCard=null;
  };

  const openModal=(card,trigger)=>{
    if(!modal||!card)return;
    const mediaScript=card.querySelector('[data-builder-product-media]');
    try{modalMedia=mediaScript?JSON.parse(mediaScript.textContent):[];}catch(error){modalMedia=[];}
    if(!modalMedia.length&&card.dataset.image)modalMedia=[{src:card.dataset.image,alt:card.dataset.productTitle||''}];
    modalMediaIndex=0;
    modalReturnFocus=trigger||null;
    modalActiveCard=card;
    const v=variantData(card);
    const recommendation=card.querySelector('[data-builder-recommendation]')?.textContent?.trim()||'';
    const description=card.querySelector('[data-builder-quick-description]')?.textContent?.trim()||'';
    modalVendor.textContent=card.dataset.vendor||'Get Real Board Shop';
    modalTitle.textContent=card.dataset.productTitle||'';
    modalPrice.textContent=money(v.price||Number(card.dataset.price)||0);
    modalQuantity.textContent=Number(card.dataset.quantity||1)>1?`Quantity in setup: ${card.dataset.quantity}`:'Quantity in setup: 1';
    modalVariant.textContent=v.variantTitle&&v.variantTitle!=='Default Title'?v.variantTitle:'Standard option';
    modalVariantWrap.hidden=false;
    modalRecommendation.textContent=recommendation;
    modalRecommendationWrap.hidden=!recommendation;
    modalDescription.textContent=description||'See the full product page for complete specifications and additional information.';
    modalProductLink.href=card.dataset.productUrl||'#';
    modalThumbs.innerHTML='';
    modalMedia.forEach((item,index)=>{
      const button=document.createElement('button');
      button.type='button';
      button.className='gr-builder-modal__thumbnail';
      button.dataset.builderModalThumbnail='';
      button.setAttribute('aria-label',`View image ${index+1}`);
      const image=document.createElement('img');
      image.src=item.src;
      image.alt='';
      button.appendChild(image);
      button.addEventListener('click',()=>{modalMediaIndex=index;renderModalMedia();});
      modalThumbs.appendChild(button);
    });
    renderModalMedia();
    modal.hidden=false;
    modal.setAttribute('aria-hidden','false');
    document.body.classList.add('gr-builder-modal-open');
    section.querySelector('[data-builder-modal-close].gr-builder-modal__x')?.focus();
  };

  const count=()=>keys.filter(k=>selections[k]).length;
  const updateTotal=()=>{totalEl.textContent=money(keys.reduce((sum,k)=>selections[k]?sum+selections[k].price*selections[k].quantity:sum,0));};

  const updateSummary=key=>{
    const item=section.querySelector(`[data-summary-item="${key}"]`);if(!item)return;
    const s=selections[key],img=item.querySelector('[data-summary-image]'),ph=item.querySelector('[data-summary-placeholder]'),title=item.querySelector('[data-summary-title]'),variant=item.querySelector('[data-summary-variant]'),change=item.querySelector('[data-summary-change]');
    if(!s){img.hidden=true;img.removeAttribute('src');img.alt='';ph.hidden=false;title.textContent='Not selected';variant.textContent='';change.hidden=true;return;}
    if(s.image){img.src=s.image;img.alt=s.productTitle;img.hidden=false;ph.hidden=true}else{img.hidden=true;ph.hidden=false}
    title.textContent=s.productTitle;
    const parts=[];if(s.variantTitle&&s.variantTitle!=='Default Title')parts.push(s.variantTitle);if(s.quantity>1)parts.push(`Qty ${s.quantity}`);
    variant.textContent=parts.join(' · ');change.hidden=false;
  };

  const updateAdd=()=>{addAll.disabled=count()!==keys.length||adding;};
  const updateStepper=()=>stepper.forEach((item,i)=>{
    const done=!!selections[keys[i]];
    item.classList.toggle('is-active',i===current);
    item.classList.toggle('is-complete',done&&i!==current);
    item.disabled=i>current&&!done;
  });
  const updateNav=()=>{
    back.disabled=current===0;next.disabled=!selections[keys[current]];
    next.innerHTML=current===steps.length-1?'Review build <span aria-hidden="true">→</span>':'Next step <span aria-hidden="true">→</span>';
    updateStepper();
  };

  const showStep=(index,scroll=true)=>{
    current=Math.max(0,Math.min(index,steps.length-1));
    steps.forEach((step,i)=>{step.hidden=i!==current;step.classList.toggle('is-active',i===current);});
    progressFill.style.width=`${((current+1)/steps.length)*100}%`;
    stepCount.textContent=`Step ${current+1} of ${steps.length}`;
    progressLabel.textContent=steps[current].dataset.stepHeading||'';
    if(current===1)applyTruckRecommendations();
    updateNav();
    if(scroll)window.scrollTo({top:section.getBoundingClientRect().top+window.scrollY-20,behavior:'smooth'});
  };

  const variantData=card=>{
    const select=card.querySelector('[data-builder-variant-select]'),option=select?select.options[select.selectedIndex]:null;
    return{
      variantId:Number(option?option.value:card.dataset.variantId),
      price:Number(option?option.dataset.price:card.dataset.price),
      variantTitle:option?option.dataset.variantTitle:card.dataset.variantTitle,
      available:option?option.dataset.available==='true':card.dataset.available==='true'
    };
  };

  const choose=card=>{
    const key=card.dataset.stepKey,v=variantData(card);if(!v.available||!v.variantId)return;
    card.closest('[data-builder-step]').querySelectorAll('[data-builder-product]').forEach(other=>{
      other.classList.remove('is-selected');const b=other.querySelector('[data-builder-select]');if(b)b.textContent='Choose this';
    });
    card.classList.add('is-selected');const button=card.querySelector('[data-builder-select]');if(button)button.textContent='Selected';
    selections[key]={variantId:v.variantId,price:v.price,variantTitle:v.variantTitle,productTitle:card.dataset.productTitle,image:card.dataset.image,quantity:Number(card.dataset.quantity||1)};
    if(key==='deck'){
      deckWidth=widthFrom(`${v.variantTitle} ${card.dataset.productTitle}`);
      selections.trucks=null;updateSummary('trucks');
      section.querySelectorAll('[data-builder-product][data-step-key="trucks"]').forEach(c=>{c.classList.remove('is-selected');const b=c.querySelector('[data-builder-select]');if(b)b.textContent='Choose this';});
      applyTruckRecommendations();
    }
    updateSummary(key);updateTotal();updateNav();updateAdd();message.textContent='';
  };

  section.querySelectorAll('[data-builder-select],[data-builder-card-select]').forEach(control=>control.addEventListener('click',e=>{e.preventDefault();choose(control.closest('[data-builder-product]'));}));
  section.querySelectorAll('[data-builder-product]').forEach(card=>card.addEventListener('click',e=>{if(e.target.closest('select,a,button'))return;choose(card);}));

  section.querySelectorAll('[data-builder-details]').forEach(button=>button.addEventListener('click',event=>{
    event.preventDefault();
    event.stopPropagation();
    openModal(button.closest('[data-builder-product]'),button);
  }));
  section.querySelectorAll('[data-builder-modal-close]').forEach(button=>button.addEventListener('click',closeModal));
  modalChoose?.addEventListener('click',()=>{
    if(!modalActiveCard)return;
    const card=modalActiveCard;
    choose(card);
    closeModal();
  });
  modalPrevious?.addEventListener('click',()=>{modalMediaIndex=(modalMediaIndex-1+modalMedia.length)%modalMedia.length;renderModalMedia();});
  modalNext?.addEventListener('click',()=>{modalMediaIndex=(modalMediaIndex+1)%modalMedia.length;renderModalMedia();});
  document.addEventListener('keydown',event=>{if(event.key==='Escape'&&modal&&!modal.hidden)closeModal();});

  section.querySelectorAll('[data-builder-variant-select]').forEach(select=>{
    select.addEventListener('click',e=>e.stopPropagation());
    select.addEventListener('change',()=>{
      const card=select.closest('[data-builder-product]'),option=select.options[select.selectedIndex],price=card.querySelector('[data-builder-card-price]'),button=card.querySelector('[data-builder-select]');
      price.textContent=money(Number(option.dataset.price));button.disabled=option.dataset.available!=='true';button.textContent=option.dataset.available==='true'?'Choose this':'Sold out';
      if(card.classList.contains('is-selected')){const key=card.dataset.stepKey;selections[key]=null;card.classList.remove('is-selected');updateSummary(key);updateTotal();updateNav();updateAdd();}
    });
  });

  section.querySelectorAll('[data-builder-search]').forEach(input=>input.addEventListener('input',()=>{
    const q=input.value.trim().toLowerCase();
    input.closest('[data-builder-step]').querySelectorAll('[data-builder-product]').forEach(card=>{
      const incompatible=card.dataset.stepKey==='trucks'&&card.dataset.compatible==='false';
      card.hidden=incompatible||(q!==''&&!(card.dataset.searchText||'').includes(q));
    });
  }));

  section.querySelectorAll('[data-builder-profile]').forEach(button=>button.addEventListener('click',()=>{
    const profile=button.dataset.builderProfile;
    if(profile==='shop'){paths.hidden=true;guide.hidden=false;return;}
    startApp(profile);
  }));
  section.querySelector('[data-builder-guide-cancel]').addEventListener('click',()=>{guide.hidden=true;paths.hidden=false;});
  section.querySelector('[data-builder-guide-submit]').addEventListener('click',showRecommendation);
  section.querySelector('[data-builder-recommendation-back]').addEventListener('click',()=>{recommendationScreen.hidden=true;guide.hidden=false;});
  section.querySelectorAll('[data-builder-recommendation-choice]').forEach(button=>button.addEventListener('click',()=>{
    const choice=button.dataset.builderRecommendationChoice;
    beginRecommendedBuild(choice==='primary'?section.dataset.guidedPrimary:section.dataset.guidedSecondary);
  }));
  section.querySelector('[data-builder-recommendation-all]').addEventListener('click',()=>beginRecommendedBuild('',true));

  back.addEventListener('click',()=>showStep(current-1));
  next.addEventListener('click',()=>{if(!selections[keys[current]])return;current<steps.length-1?showStep(current+1):section.querySelector('.gr-builder-summary').scrollIntoView({behavior:'smooth',block:'start'});});
  stepper.forEach(item=>item.addEventListener('click',()=>{const target=Number(item.dataset.builderStepJump);if(target<=current||selections[keys[target]])showStep(target);}));
  section.querySelectorAll('[data-summary-change]').forEach(button=>button.addEventListener('click',()=>showStep(Number(button.dataset.summaryChange))));

  addAll.addEventListener('click',async()=>{
    if(adding||count()!==keys.length)return;
    adding=true;addAll.disabled=true;addLabel.textContent='Adding setup...';message.textContent='';
    const requestedAssembly=assemblyRequest?.checked===true;
    const items=keys.map(key=>({
      id:selections[key].variantId,
      quantity:selections[key].quantity,
      properties:{
        '_Get Real Build':'Complete Setup',
        '_Free Get Real Stickers':'Included',
        ...(requestedAssembly?{'Assembly + grip application':'Requested'}:{})
      }
    }));
    try{
      const root=window.Shopify?.routes?.root||'/';
      const response=await fetch(`${root}cart/add.js`,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items})});
      if(!response.ok){const error=await response.json();throw new Error(error.description||error.message||'The setup could not be added.');}
      message.textContent='Your complete setup was added to the cart.';addLabel.textContent='Setup added';setTimeout(()=>{window.location.href=`${root}cart`;},650);
    }catch(error){message.textContent=error.message||'Something went wrong. Please try again.';addLabel.textContent='Add complete setup';adding=false;updateAdd();}
  });

  updateTotal();updateAdd();showStep(0,false);
})();
</script>

