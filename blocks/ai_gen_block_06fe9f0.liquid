{% doc %}
  @prompt
    I want to build out what is included in the dj lessons such as DJ Listening Lab is a hands-on DJ program focused on learning how to mix vinyl records by ear in a relaxed and supportive environment.
    
    Classes are designed for beginners and developing DJs who want to build real skills including:
    
    • Beat-matching by ear
    • Clean transitions and longer blends
    • Understanding DJ equipment and signal flow
    • Developing musical taste and record selection
    • Practicing with intention and confidence
    
    Each session is 2 hours and takes place inside Get Real Board Shop.
    
    Class Details
    • Weekday Evenings: 6:00 PM – 8:00 PM
    • Beginner-friendly — no experience required
    • $60 per session
    • Optional follow-up lessons available
    Practice Time
    Students can book additional turntable practice sessions during shop hours.
    • $20 per hour
    • Great for building confidence between lessons
    • Instructor support available when in-store
    Who This Is For
    • Complete beginners curious about DJing
    • Music lovers who want to understand vinyl
    • DJs looking to improve mixing by ear
    • Youth and adults interested in creative skill-building
    Get Started
    To schedule your first session or ask a question, contact:
    
    Theron Sunderland
    DJ Listening Lab Instructor
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dj-lessons-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 40px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-dj-lessons-header-{{ ai_gen_id }} {
    margin-bottom: 32px;
  }

  .ai-dj-lessons-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 16px 0;
    color: {{ block.settings.text_color }};
  }

  .ai-dj-lessons-intro-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .ai-dj-lessons-section-{{ ai_gen_id }} {
    margin-bottom: 32px;
  }

  .ai-dj-lessons-section-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    margin: 0 0 16px 0;
    color: {{ block.settings.accent_color }};
  }

  .ai-dj-lessons-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 16px 0;
  }

  .ai-dj-lessons-list-{{ ai_gen_id }} li {
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
    padding-left: 24px;
    position: relative;
    margin-bottom: 8px;
  }

  .ai-dj-lessons-list-{{ ai_gen_id }} li:before {
    content: "•";
    position: absolute;
    left: 8px;
    color: {{ block.settings.accent_color }};
    font-weight: bold;
  }

  .ai-dj-lessons-details-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 24px;
    margin-bottom: 32px;
  }

  .ai-dj-lessons-detail-card-{{ ai_gen_id }} {
    padding: 20px;
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-dj-lessons-detail-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    font-weight: 600;
    color: {{ block.settings.accent_color }};
    margin-bottom: 8px;
  }

  .ai-dj-lessons-detail-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
  }

  .ai-dj-lessons-cta-{{ ai_gen_id }} {
    margin-top: 32px;
    padding-top: 32px;
    border-top: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-dj-lessons-cta-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    margin: 0 0 16px 0;
    color: {{ block.settings.accent_color }};
  }

  .ai-dj-lessons-cta-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .ai-dj-lessons-instructor-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-dj-lessons-{{ ai_gen_id }} {
      padding: 24px;
      width: 100%;
    }

    .ai-dj-lessons-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-dj-lessons-section-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.section_title_size }}px * 0.9);
    }

    .ai-dj-lessons-details-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<dj-lessons-{{ ai_gen_id }} class="ai-dj-lessons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dj-lessons-header-{{ ai_gen_id }}">
    <h2 class="ai-dj-lessons-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    <div class="ai-dj-lessons-intro-{{ ai_gen_id }}">
      {{ block.settings.intro_text }}
    </div>
  </div>

  {% if block.settings.show_skills_section %}
    <div class="ai-dj-lessons-section-{{ ai_gen_id }}">
      <h3 class="ai-dj-lessons-section-title-{{ ai_gen_id }}">{{ block.settings.skills_title }}</h3>
      <ul class="ai-dj-lessons-list-{{ ai_gen_id }}">
        {% if block.settings.skill_1 != blank %}
          <li>{{ block.settings.skill_1 }}</li>
        {% endif %}
        {% if block.settings.skill_2 != blank %}
          <li>{{ block.settings.skill_2 }}</li>
        {% endif %}
        {% if block.settings.skill_3 != blank %}
          <li>{{ block.settings.skill_3 }}</li>
        {% endif %}
        {% if block.settings.skill_4 != blank %}
          <li>{{ block.settings.skill_4 }}</li>
        {% endif %}
        {% if block.settings.skill_5 != blank %}
          <li>{{ block.settings.skill_5 }}</li>
        {% endif %}
      </ul>
      <div class="ai-dj-lessons-intro-{{ ai_gen_id }}">
        {{ block.settings.session_info }}
      </div>
    </div>
  {% endif %}

  <div class="ai-dj-lessons-details-grid-{{ ai_gen_id }}">
    {% if block.settings.show_class_details %}
      <div class="ai-dj-lessons-detail-card-{{ ai_gen_id }}">
        <div class="ai-dj-lessons-detail-label-{{ ai_gen_id }}">{{ block.settings.class_details_title }}</div>
        <div class="ai-dj-lessons-detail-value-{{ ai_gen_id }}">
          {{ block.settings.class_details_content }}
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_practice_time %}
      <div class="ai-dj-lessons-detail-card-{{ ai_gen_id }}">
        <div class="ai-dj-lessons-detail-label-{{ ai_gen_id }}">{{ block.settings.practice_title }}</div>
        <div class="ai-dj-lessons-detail-value-{{ ai_gen_id }}">
          {{ block.settings.practice_content }}
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_who_for %}
      <div class="ai-dj-lessons-detail-card-{{ ai_gen_id }}">
        <div class="ai-dj-lessons-detail-label-{{ ai_gen_id }}">{{ block.settings.who_for_title }}</div>
        <div class="ai-dj-lessons-detail-value-{{ ai_gen_id }}">
          {{ block.settings.who_for_content }}
        </div>
      </div>
    {% endif %}
  </div>

  {% if block.settings.show_cta %}
    <div class="ai-dj-lessons-cta-{{ ai_gen_id }}">
      <h3 class="ai-dj-lessons-cta-title-{{ ai_gen_id }}">{{ block.settings.cta_title }}</h3>
      <div class="ai-dj-lessons-cta-text-{{ ai_gen_id }}">
        {{ block.settings.cta_text }}
      </div>
      <div class="ai-dj-lessons-instructor-{{ ai_gen_id }}">
        {{ block.settings.instructor_name }}
      </div>
    </div>
  {% endif %}
</dj-lessons-{{ ai_gen_id }}>

<script>
  (function() {
    class DjLessons{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('dj-lessons-{{ ai_gen_id }}', DjLessons{{ ai_gen_id }});
  })();
</script>

